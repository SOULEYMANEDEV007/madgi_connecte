# Environment
ENVIRONMENT=development
APP_NAME=MADGI Connect
APP_VERSION=1.0.0

# API Configuration
API_BASE_URL=
API_VERSION=v1
API_TIMEOUT=30000

# Authentication Endpoints
AUTH_LOGIN_ENDPOINT=/connexion
AUTH_LOGOUT_ENDPOINT=/logout
AUTH_REFRESH_ENDPOINT=/refresh-token

# Attendance Endpoints
ATTENDANCE_MANUAL_ENDPOINT=/emarger
ATTENDANCE_QR_ENDPOINT=/register
ATTENDANCE_GET_AGENT_ENDPOINT=/get-agent
ATTENDANCE_WORK_TIME_ENDPOINT=/work-time

# Agent Management
AGENT_PROFILE_ENDPOINT=/agent/profile
AGENT_UPDATE_ENDPOINT=/agent/update
AGENT_STATS_ENDPOINT=/agent/stats

# Reports
REPORT_DAILY_ENDPOINT=/reports/daily
REPORT_MONTHLY_ENDPOINT=/reports/monthly
ATTENDANCE_STATS_ENDPOINT=/stats/attendance

# Admin
ADMIN_AGENTS_ENDPOINT=/admin/agents
ADMIN_DEPARTMENTS_ENDPOINT=/admin/departments
ADMIN_SETTINGS_ENDPOINT=/admin/settings/attendance